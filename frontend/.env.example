# Server-side only. Copy to .env.local, fill your key, then restart Vite.
# Never prefix the key with VITE_ or commit .env.local.
# OPENAI_HOST automatically selects the compatible API. No provider setting needed.
OPENAI_HOST=http://localhost:20128/v1
OPENAI_API_KEY=
# Copy the exact model ID shown in your 9Router dashboard (including routing prefix).
OPENAI_MODEL=nvidia/nvidia/nemotron-3-ultra-550b-a55b

# To select Gemini instead, set TRANSLATE_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Translation limits (server-side); restart Vite after changes.
TRANSLATE_DAILY_LIMIT=20
TRANSLATE_IP_DAILY_LIMIT=100
TRANSLATE_GLOBAL_DAILY_LIMIT=1000
TRANSLATE_COOLDOWN_SECONDS=10
TRANSLATE_MAX_OUTPUT_TOKENS=4096
