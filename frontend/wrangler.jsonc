{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "english-learning-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "rules": [{ "type": "Text", "globs": ["**/_headers"], "fallthrough": true }],
  "vars": {
    "OPENAI_HOST": "https://generativelanguage.googleapis.com/v1beta/openai",
    "OPENAI_MODEL": "gemini-2.5-flash-lite",
    "TRANSLATE_DAILY_LIMIT": "30",
    "TRANSLATE_IP_DAILY_LIMIT": "100",
    "TRANSLATE_GLOBAL_DAILY_LIMIT": "1000",
    "TRANSLATE_COOLDOWN_SECONDS": "10",
    "TRANSLATE_MAX_OUTPUT_TOKENS": "4096",
  },
  "durable_objects": {
    "bindings": [
      { "name": "TRANSLATION_LIMITS", "class_name": "TranslationLimitsObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TranslationLimitsObject"] },
  ],
}
