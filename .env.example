# Optional future cloud configuration; not consumed by the setup page.
# Copy to frontend/.env.local when implementing cloud integration.
# All VITE_* values are public in the browser bundle.
# Leave blank until a real Supabase project is configured.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
